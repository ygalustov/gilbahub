<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            GH-791 (queue item 3gp): the whole suite in one process peaks above the 128M default, so
            `php artisan test` died partway through for everybody who ran it - measured: Unit alone 44.5M,
            Feature alone 127M, both together 133M, and the case it died on was whichever one crossed the
            line. The place it died (a compiled Blade template encoding the dependency graph) was where the
            memory ran out, not why. WHY it grows by roughly 80M over 597 tests is not established and is
            named as a boundary rather than hidden by this line: a client's request is one process for one
            request, so the growth is the harness's, but the ceiling is raised here so that a run reaches its
            end and reports what it found.

            MEASURED WITH THIS LINE IN PLACE, because "it does not fit without it" and "how much room is left
            with it" are two different facts: the whole suite peaks at 133 MB of the 512 granted, 26% of the
            ceiling, 379 MB spare. So the number is not a guess at a safe margin, and if the peak ever
            approaches it that will be visible rather than sudden.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
